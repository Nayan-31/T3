# Mistral aur Pinecone ki server-side API keys.
MISTRALAI_API_KEY=
PINECONE_API_KEY=

# Existing dense index: dimension 1024, cosine metric, using mistral-embed.
PINECONE_INDEX=chill

# Dedicated namespace: original RAG demo ke records alag rahenge.
PINECONE_NAMESPACE=replyroom-v1

# Final answers, query rewriting aur reranking ke liye chat model.
MISTRAL_CHAT_MODEL=mistral-small-latest

# Chat ke liye gemini ya mistral; embeddings Mistral hi use karti hain.
CHAT_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.5-flash
