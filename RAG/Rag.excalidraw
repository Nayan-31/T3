    {
      "id": "AtB9KKAphoQBnTYbrQEi5",
      "type": "text",
      "x": -8.20205067478446,
      "y": 3491.725100349453,
      "width": 360.4117054399727,
      "height": 310.30823063543795,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
