    {
      "id": "vGXq9RWH5eJ_by95VCS2X",
      "type": "text",
      "x": -2811.7300269444627,
      "y": 1801.7910755965481,
      "width": 784.3193969726562,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3V",
      "roundness": null,
      "seed": 13491400,
      "version": 304,
      "versionNonce": 1489204408,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790572690881,
      "created": 1790567165695,
      "link": null,
      "locked": false,
      "text": "Basic text loaders (like LangChain's TextLoader or basic PyPDFLoader) \ndo not parse images at all and will skip or fail on image-heavy or scanned \npages. However, modern enterprise multimodal document loaders/parsers\ncombine loading, text extraction, OCR, and image captioning into a single pipeline\n",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Basic text loaders (like LangChain's TextLoader or basic PyPDFLoader) \ndo not parse images at all and will skip or fail on image-heavy or scanned \npages. However, modern enterprise multimodal document loaders/parsers\ncombine loading, text extraction, OCR, and image captioning into a single pipeline\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
