      "seed": 206522568,
      "version": 377,
      "versionNonce": 651828920,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790572690881,
      "created": 1790569479850,
      "link": null,
      "locked": false,
      "text": "Suppose DB me:\n\nHR\nEngineering\nFinance\nLegal\n\nsab hai. User Engineering se hai. Pehle:\ndepartment = engineering , filter karo.\nThen semantic search. So:\n\nMetadata Filter\n↓\nSmaller allowed dataset\n↓\nVector Search\n\nBenefits:\n\nbetter relevance\nbetter security\nbetter performance",
      "fontSize": 11.28393565947047,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Suppose DB me:\n\nHR\nEngineering\nFinance\nLegal\n\nsab hai. User Engineering se hai. Pehle:\ndepartment = engineering , filter karo.\nThen semantic search. So:\n\nMetadata Filter\n↓\nSmaller allowed dataset\n↓\nVector Search\n\nBenefits:\n\nbetter relevance\nbetter security\nbetter performance",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
