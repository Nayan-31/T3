      "version": 168,
      "versionNonce": 1946881992,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790572690881,
      "created": 1790568154272,
      "link": null,
      "locked": false,
      "text": "Metadata extraction in Retrieval-Augmented Generation (RAG) \nmeans automatically pulling descriptive, structured details—like\nauthors, dates, document types, product IDs, or section headers—from\nunstructured source files so they can be stored alongside text embeddings",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Metadata extraction in Retrieval-Augmented Generation (RAG) \nmeans automatically pulling descriptive, structured details—like\nauthors, dates, document types, product IDs, or section headers—from\nunstructured source files so they can be stored alongside text embeddings",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
