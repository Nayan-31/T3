{
  "openapi": "3.0.3",
  "info": {
    "title": "My Users API",
    "version": "1.0.0",
    "description": "Users API ki documentation"
  },
  "servers": [
    {
      "url": "http://localhost:3000"
    }
  ],
  "tags": [
    {
      "name": "Users",
      "description": "User related APIs"
    }
  ],
  "paths": {
    "/api/users": {
      "get": {
        "summary": "Users ki list lao",
        "responses": {
          "200": {
            "description": "Users ki list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/User"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "User": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string",
            "example": "1"
          },
          "name": {
            "type": "string",
            "example": "Nayan"
          }
        }
      }
    }
  }
}